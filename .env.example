# --- Local development (npm run dev in apps/api and apps/web) ---

# API server
HOST=0.0.0.0
PORT=3000

# Web dev server
WEB_PORT=5173

# Where the web app finds the API (must be reachable from the browser)
VITE_API_URL=http://localhost:3000

# All data lives under this directory (RULES.md R-13)
DATA_DIR=./data

# --- Docker / docker-compose (both dev and deployment) ---

# Host ports docker-compose publishes the containers on
API_PORT=3000
WEB_HTTP_PORT=8080

# Where the browser reaches the API once deployed — the server's LAN
# address or hostname, e.g. http://192.168.1.50:3000. Read at container
# start, not baked into the image (see apps/web/docker-entrypoint.d).
API_URL=http://localhost:3000

# Event timezone, never inferred from the host (RULES.md R-20)
TZ=UTC
