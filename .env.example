# --- Local development (npm run dev in apps/api and apps/web) ---

# API server
HOST=0.0.0.0
PORT=3000

# Web dev server
WEB_PORT=5173

# Where the web app finds the API (must be reachable from the browser)
VITE_API_URL=http://localhost:3000

# All data lives under this directory (RULES.md R-13)
DATA_DIR=./data

# --- Docker / docker-compose (both dev and deployment) ---

# Host ports docker-compose publishes the containers on
API_PORT=3000
WEB_HTTP_PORT=8085

# Where the browser reaches the API once deployed — the server's LAN
# address or hostname. Read at container start, not baked into the
# image (see apps/web/docker-entrypoint.d).
API_URL=http://192.168.1.105:3000

# Event timezone, never inferred from the host (RULES.md R-20)
TZ=UTC

# Phase 4 alternative draft panel (CONTEXT.md section 9) — the only
# feature that calls out to the network. Leave empty to disable it;
# the endpoint returns a clear error instead of silently doing nothing.
ANTHROPIC_API_KEY=

# Phase 5.5 login (D-026). ADMIN_USERNAME/ADMIN_PASSWORD create the one
# admin account on first startup only — change the password by logging
# in and using the app, not by editing these again. SESSION_SECRET can
# be any string (it's hashed to the right length, not used raw); losing
# or changing it logs everyone out.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
